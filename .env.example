NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# OAuth Google Drive personal (buat OAuth Client type Web application)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# Opsional: ID folder induk. Jika kosong, folder arsip dibuat di root My Drive.
GOOGLE_DRIVE_FOLDER_ID=
# Server-only: dipakai untuk menyimpan refresh token OAuth secara aman.
SUPABASE_SERVICE_ROLE_KEY=
